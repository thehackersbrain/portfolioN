---
import { SITE } from '@/consts'
import { isSubpost, parseAuthors } from '@/lib/data-utils'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props

const title = post.data.title || SITE.title
const description = post.data.description || SITE.description
const site = Astro.site ?? new URL(SITE.href)

const authors = await parseAuthors(post.data.authors ?? [])
const authorNames = authors.length ? authors.map((a) => a.name) : [SITE.name]

const canonicalURL = new URL(
  Astro.url.pathname.replace(/\/+$/, '') || '/',
  site,
)

// Prefer the post's own cover image; fall back to the site-wide OG card.
const image = post.data.image?.src
  ? new URL(post.data.image.src, site)
  : new URL('/static/1200x630.png', site)

const publishedTime = post.data.date?.toISOString() || new Date().toISOString()
// Use published time as modified time if no updatedDate field exists
const modifiedTime = publishedTime

// Article Schema for better SEO and AI/GEO optimization
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title.slice(0, 110),
  description,
  image: image.href,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  inLanguage: SITE.locale,
  author: authorNames.map((name) => ({
    '@type': 'Person',
    name,
    url: SITE.href,
  })),
  publisher: {
    '@type': 'Person',
    name: SITE.name,
    url: SITE.href,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.href,
  },
  url: canonicalURL.href,
  ...(post.data.tags &&
    post.data.tags.length > 0 && {
      keywords: post.data.tags.join(', '),
    }),
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.href },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: new URL('/blog', site).href,
    },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalURL.href },
  ],
}
---

<title>{`${title} | ${SITE.title}`}</title>
<meta name="description" content={description} />
<meta name="author" content={authorNames.join(', ')} />
<link rel="canonical" href={canonicalURL.href} />

{
  isSubpost(post.id) ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:type" content="article" />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:url" content={canonicalURL.href} />

<meta property="article:published_time" content={publishedTime} />
<meta property="article:modified_time" content={modifiedTime} />
{authorNames.map((name) => <meta property="article:author" content={name} />)}
{
  post.data.tags?.map((tag: string) => (
    <meta property="article:tag" content={tag} />
  ))
}

<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image.href} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@thehackersbrain" />
<meta name="twitter:creator" content="@thehackersbrain" />

<!-- Article Schema Markup for AI/GEO and Rich Snippets -->
<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbSchema)}
/>
