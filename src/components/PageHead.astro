---
import { SITE } from '@/consts'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
  /** Absolute or site-relative URL to override the derived canonical. */
  canonical?: string
  /** Rel prev/next for paginated listings. */
  prev?: string
  next?: string
}

const {
  title,
  description = SITE.description,
  noindex = false,
  canonical,
  prev,
  next,
} = Astro.props

// The homepage keeps its title verbatim; every other page gets the brand suffix.
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.defaultTitle

// Canonical must point at *this* page, not the site root. Trailing slashes are
// stripped so `/blog` and `/blog/` never canonicalise to two different URLs.
const site = Astro.site ?? new URL(SITE.href)
const canonicalURL = new URL(
  canonical ?? (Astro.url.pathname.replace(/\/+$/, '') || '/'),
  site,
)

const image = new URL('/static/1200x630.png', site)
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.name} />
<link rel="canonical" href={canonicalURL.href} />
{prev && <link rel="prev" href={new URL(prev, site).href} />}
{next && <link rel="next" href={new URL(next, site).href} />}
{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title ?? SITE.title} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={SITE.ogLocale} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:url" content={canonicalURL.href} />

<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image.href} />
<meta name="twitter:image:alt" content={title ?? SITE.title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@thehackersbrain" />
<meta name="twitter:creator" content="@thehackersbrain" />
