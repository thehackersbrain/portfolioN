---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import PFCard from '@/components/PFCard.astro'
import FeaturedWritings from '@/components/FeaturedWritings.astro'
import PublishedWork from '@/components/PublishedWork.astro'
import GithubCalendar from '@/components/react/GithubCalendar'
import ResearchAndFeatures from '@/components/ResearchAndFeatures.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE, SOCIAL_LINKS } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getFeaturedProjects, getRecentPosts } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

const blog = await getRecentPosts(SITE.featuredPostCount)
const projects = await getFeaturedProjects()

// Profiles Google can use to reconcile the entity behind this site.
const sameAs = SOCIAL_LINKS.map((link) => link.href).filter((href) =>
  href.startsWith('http'),
)

// Person Schema for homepage SEO — the site is a personal portfolio, so the
// Person is the primary entity and the WebSite points back at it.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.href}/#person`,
  name: SITE.name,
  alternateName: SITE.author,
  url: SITE.href,
  image: `${SITE.href}/static/profile.png`,
  description: SITE.description,
  jobTitle: 'Offensive Security Researcher & Software Engineer',
  email: 'mailto:gaurav@thehackersbrain.dev',
  worksFor: {
    '@type': 'Organization',
    name: 'Cybercraft Labs',
  },
  knowsAbout: [
    'Offensive Security',
    'Red Team Operations',
    'Linux Kernel Development',
    'Systems Programming',
    'Malware Research',
    'Software Engineering',
  ],
  sameAs,
}

// Website Schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.href}/#website`,
  name: SITE.title,
  url: SITE.href,
  description: SITE.description,
  inLanguage: SITE.locale,
  publisher: { '@id': `${SITE.href}/#person` },
}
---

<Layout class="max-w-3xl">
  <PageHead slot="head" />

  <!-- Schema Markup for SEO -->
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(websiteSchema)}
  />

  <section class="rounded-lg rounded-tl-none rounded-br-none border">
    <div class="flex flex-col space-y-1.5 p-6">
      <h1 class="font-tech text-3xl leading-none font-bold">Gaurav Raj</h1>
      <p class="text-muted-foreground font-s-tech text-sm font-normal">
        (thehackersbrain) &bull; Security Researcher &amp; Software Engineer
      </p>
    </div>
    <div class="p-6 pt-0">
      <p class="text-muted-foreground mb-2 text-sm">
        Offensive Security Researcher & Software Engineer. Specialized in
        low-level systems programming (C/ASM/Rust), Linux internals, kernel
        development, malware development, and red team operations. Strong
        crossover between kernel engineering, cloud infrastructure, and
        full-stack development.
      </p>
    </div>
  </section>

  <section class="featured-projects">
    <h2 class="font-ss-tech mb-3 text-2xl font-bold">Featured Projects</h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <PFCard project={project} />)}
    </div>
    <div class="mt-3 flex justify-end">
      <Link
        href="/works/projects"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        See all projects <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>

  <FeaturedWritings />

  <ResearchAndFeatures />
  <PublishedWork />

  <section class="flex flex-col gap-y-4">
    <h2 class="font-ss-tech text-2xl font-bold">Latest posts</h2>
    <ul class="flex flex-col gap-y-4">
      {
        blog.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
    <div class="flex justify-end">
      <Link
        href="/blog"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        See all posts <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>

  <section
    class="text-muted-foreground flex flex-col items-center justify-center rounded-lg border p-6 pt-3 text-xs"
  >
    <GithubCalendar username="thehackersbrain" client:load />
    <h2 class="font-ss-tech text-lg font-semibold">
      Github Contribution Graph
    </h2>
  </section>

  <section>
    <div
      class="flex flex-col items-center justify-between gap-4 rounded-xl border p-6 sm:flex-row sm:items-center sm:gap-6"
    >
      <div class="text-center sm:text-left">
        <h3 class="font-ss-tech text-xl font-bold">Want to work together?</h3>
        <p class="text-muted-foreground mt-2 text-sm">
          Have question, project or want to collaborate? Feel free to reach out!
        </p>
      </div>
      <Link
        href="mailto:gaurav@thehackersbrain.dev"
        class={buttonVariants({ variant: 'outline' }) +
          ' group shrink-0 inline-flex items-center gap-2'}
      >
        <Icon name="lucide:mail" class="size-4" />
        Contact Me
      </Link>
    </div>
  </section>
</Layout>
